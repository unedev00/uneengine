{
  "apiName": "une_menu",
  "label": "UNE Menu",
  "category": "Navigation",
  "description": "Reusable menu component for metadata-driven pages; shares MetaDrive runtime, events and tenant permissions.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 1,
  "scope": "platform-core",
  "jsxFile": "one/une_menu/UneMenu.jsx",
  "cssFile": "one/une_menu/UneMenu.css",
  "resize": {
    "defaultWidth": 320,
    "defaultHeight": 90,
    "minWidth": 120,
    "minHeight": 44
  },
  "propertyDefinitions": [
    {
      "propertyKey": "borderColor",
      "label": "Border colour",
      "kind": "COLOR",
      "displayOrder": 70,
      "defaultValue": ""
    },
    {
      "propertyKey": "radius",
      "label": "Corner radius (px)",
      "kind": "NUMBER",
      "displayOrder": 90,
      "defaultValue": 20
    },
    {
      "propertyKey": "shadow",
      "label": "Shadow",
      "kind": "SELECT",
      "displayOrder": 120,
      "defaultValue": "medium",
      "choices": [
        {
          "key": "none",
          "label": "None"
        },
        {
          "key": "small",
          "label": "Small"
        },
        {
          "key": "medium",
          "label": "Medium"
        },
        {
          "key": "large",
          "label": "Large"
        }
      ]
    },
    {
      "propertyKey": "items",
      "label": "Menu links",
      "kind": "OPTIONS",
      "displayOrder": 300,
      "defaultValue": []
    }
  ],
  "eventDefinitions": [
    {
      "apiName": "navigate",
      "label": "navigate"
    }
  ]
}
