{
  "apiName": "une_chart",
  "label": "UNE Chart",
  "category": "Display",
  "description": "Reusable chart component for metadata-driven pages; shares MetaDrive runtime, events and tenant permissions.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 1,
  "scope": "platform-core",
  "jsxFile": "one/une_chart/UneChart.jsx",
  "cssFile": "one/une_chart/UneChart.css",
  "resize": {
    "defaultWidth": 500,
    "defaultHeight": 300,
    "minWidth": 120,
    "minHeight": 44
  },
  "propertyDefinitions": [
    {
      "propertyKey": "borderColor",
      "label": "Border colour",
      "kind": "COLOR",
      "displayOrder": 70,
      "defaultValue": ""
    },
    {
      "propertyKey": "radius",
      "label": "Corner radius (px)",
      "kind": "NUMBER",
      "displayOrder": 90,
      "defaultValue": 20
    },
    {
      "propertyKey": "shadow",
      "label": "Shadow",
      "kind": "SELECT",
      "displayOrder": 120,
      "defaultValue": "medium",
      "choices": [
        {
          "key": "none",
          "label": "None"
        },
        {
          "key": "small",
          "label": "Small"
        },
        {
          "key": "medium",
          "label": "Medium"
        },
        {
          "key": "large",
          "label": "Large"
        }
      ]
    },
    {
      "propertyKey": "objectApiName",
      "label": "Source Object",
      "kind": "OBJECT",
      "displayOrder": 300,
      "defaultValue": ""
    },
    {
      "propertyKey": "items",
      "label": "Flow/Page State record collection",
      "kind": "RECORD_LIST",
      "displayOrder": 310,
      "defaultValue": []
    }
  ],
  "eventDefinitions": [
    {
      "apiName": "itemSelect",
      "label": "item Select"
    }
  ]
}
