{
  "apiName": "une_option_groups",
  "label": "UNE Option Groups",
  "category": "Inputs",
  "description": "Render grouped required/optional selections from metadata-bound Flow records; emits typed selection actions.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 1,
  "scope": "platform-core",
  "jsxFile": "one/une_option_groups/UneOptionGroups.jsx",
