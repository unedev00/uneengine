{
  "apiName": "une_option_groups",
  "label": "UNE Option Groups",
  "category": "Inputs",
  "description": "Render grouped required/optional selections from metadata-bound Flow records; emits typed selection actions.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 1,
  "scope": "platform-core",
  "jsxFile": "one/une_option_groups/UneOptionGroups.jsx",
  "cssFile": "one/une_option_groups/UneOptionGroups.css",
  "resize": {
    "defaultWidth": 480,
    "defaultHeight": 330,
    "minWidth": 200,
    "minHeight": 100
  },
  "propertyDefinitions": [
    {
      "propertyKey": "borderColor",
      "label": "Border colour",
      "kind": "COLOR",
      "displayOrder": 70,
      "defaultValue": ""
    },
    {
      "propertyKey": "radius",
      "label": "Corner radius (px)",
      "kind": "NUMBER",
      "displayOrder": 90,
      "defaultValue": 20
    },
    {
      "propertyKey": "shadow",
      "label": "Shadow",
      "kind": "SELECT",
      "displayOrder": 120,
      "defaultValue": "medium",
      "choices": [
        {
          "key": "none",
          "label": "None"
        },
        {
          "key": "small",
          "label": "Small"
        },
        {
          "key": "medium",
          "label": "Medium"
        },
        {
          "key": "large",
          "label": "Large"
        }
      ]
    }
  ],
  "eventDefinitions": [
    {
      "apiName": "change",
      "label": "Selection changed"
    },
    {
      "apiName": "confirm",
      "label": "Confirm choices"
    }
  ]
}
