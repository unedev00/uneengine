      "label": "Theme",
      "kind": "SELECT",
      "displayOrder": 10,
      "defaultValue": "light",
      "choices": [
        {
          "key": "light",
          "label": "Light"
        },
        {
          "key": "dark",
          "label": "Dark"
        }
      ]
    },
    {
