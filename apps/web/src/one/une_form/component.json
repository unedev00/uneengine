{
  "apiName": "une_form",
  "label": "UNE Form",
  "category": "Inputs",
  "description": "Reusable form component for metadata-driven pages; shares MetaDrive runtime, events and tenant permissions.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 1,
  "scope": "platform-core",
  "jsxFile": "one/une_form/UneForm.jsx",
  "cssFile": "one/une_form/UneForm.css",
  "resize": {
    "defaultWidth": 420,
    "defaultHeight": 280,
    "minWidth": 120,
    "minHeight": 44
  },
  "propertyDefinitions": [
    {
      "propertyKey": "borderColor",
      "label": "Border colour",
      "kind": "COLOR",
      "displayOrder": 70,
      "defaultValue": ""
    },
    {
      "propertyKey": "radius",
      "label": "Corner radius (px)",
      "kind": "NUMBER",
      "displayOrder": 90,
      "defaultValue": 20
    },
    {
      "propertyKey": "shadow",
      "label": "Shadow",
      "kind": "SELECT",
      "displayOrder": 120,
      "defaultValue": "medium",
      "choices": [
        {
          "key": "none",
          "label": "None"
        },
        {
          "key": "small",
          "label": "Small"
        },
        {
          "key": "medium",
          "label": "Medium"
        },
        {
          "key": "large",
          "label": "Large"
        }
      ]
    },
    {
      "propertyKey": "objectApiName",
      "label": "Source Object",
      "kind": "OBJECT",
      "displayOrder": 300,
      "defaultValue": ""
    },
    {
      "propertyKey": "title",
      "label": "Form title",
      "kind": "TEXT",
      "displayOrder": 340,
      "defaultValue": "Details"
    },
    {
      "propertyKey": "helpText",
      "label": "Help text",
      "kind": "TEXT",
      "displayOrder": 860,
      "defaultValue": ""
    }
  ],
  "eventDefinitions": [
    {
      "apiName": "submit",
      "label": "submit"
    }
  ]
}
