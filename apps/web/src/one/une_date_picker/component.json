{
  "apiName": "une_date_picker",
  "label": "UNE Date Picker",
  "category": "Inputs",
  "description": "Reusable date picker component for metadata-driven pages; shares MetaDrive runtime, events and tenant permissions.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 1,
  "scope": "platform-core",
  "jsxFile": "one/une_date_picker/UneDatePicker.jsx",
  "cssFile": "one/une_date_picker/UneDatePicker.css",
  "resize": {
    "defaultWidth": 320,
    "defaultHeight": 70,
    "minWidth": 120,
    "minHeight": 44
  },
  "propertyDefinitions": [
    {
      "propertyKey": "borderColor",
      "label": "Border colour",
      "kind": "COLOR",
      "displayOrder": 70,
      "defaultValue": ""
    },
    {
      "propertyKey": "radius",
      "label": "Corner radius (px)",
      "kind": "NUMBER",
      "displayOrder": 90,
      "defaultValue": 20
    },
    {
      "propertyKey": "shadow",
      "label": "Shadow",
      "kind": "SELECT",
      "displayOrder": 120,
      "defaultValue": "medium",
      "choices": [
        {
          "key": "none",
          "label": "None"
        },
        {
          "key": "small",
          "label": "Small"
        },
        {
          "key": "medium",
          "label": "Medium"
        },
        {
          "key": "large",
          "label": "Large"
        }
      ]
    }
  ],
  "eventDefinitions": [
    {
      "apiName": "change",
      "label": "change"
    }
  ]
}
