{
  "apiName": "une_line_items",
  "label": "UNE Line Items",
  "category": "Data",
  "description": "Reusable line items component for metadata-driven pages; shares MetaDrive runtime, events and tenant permissions.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 1,
  "scope": "platform-core",
  "jsxFile": "one/une_line_items/UneLineItems.jsx",
  "cssFile": "one/une_line_items/UneLineItems.css",
  "resize": {
    "defaultWidth": 500,
    "defaultHeight": 320,
    "minWidth": 120,
    "minHeight": 44
  },
  "propertyDefinitions": [
    {
      "propertyKey": "borderColor",
      "label": "Border colour",
      "kind": "COLOR",
      "displayOrder": 70,
      "defaultValue": ""
    },
    {
      "propertyKey": "radius",
      "label": "Corner radius (px)",
      "kind": "NUMBER",
      "displayOrder": 90,
      "defaultValue": 20
    },
    {
      "propertyKey": "shadow",
      "label": "Shadow",
      "kind": "SELECT",
      "displayOrder": 120,
      "defaultValue": "medium",
      "choices": [
        {
          "key": "none",
          "label": "None"
        },
        {
          "key": "small",
          "label": "Small"
        },
        {
          "key": "medium",
          "label": "Medium"
        },
        {
          "key": "large",
          "label": "Large"
        }
      ]
    },
    {
      "propertyKey": "fields",
      "label": "Line item fields",
      "kind": "FIELD_LIST",
      "displayOrder": 310,
      "defaultValue": []
    }
  ],
  "eventDefinitions": [
    {
      "apiName": "change",
      "label": "change"
    },
    {
      "apiName": "submit",
      "label": "submit"
    }
  ]
}
