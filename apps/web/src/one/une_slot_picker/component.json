{
  "apiName": "une_slot_picker",
  "label": "UNE Slot Picker",
  "category": "Inputs",
  "description": "Reusable slot picker component for metadata-driven pages; shares MetaDrive runtime, events and tenant permissions.",
  "surfaces": [
    "page",
    "dashboard",
    "flow"
  ],
  "version": 1,
  "scope": "platform-core",
  "jsxFile": "one/une_slot_picker/UneSlotPicker.jsx",
  "cssFile": "one/une_slot_picker/UneSlotPicker.css",
  "resize": {
    "defaultWidth": 320,
    "defaultHeight": 90,
    "minWidth": 120,
    "minHeight": 44
  },
  "propertyDefinitions": [
    {
      "propertyKey": "theme",
      "label": "Theme",
      "kind": "SELECT",
      "displayOrder": 10,
      "defaultValue": "light",
      "choices": [
        {
          "key": "light",
          "label": "Light"
        },
        {
          "key": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "propertyKey": "borderColor",
      "label": "Border colour",
      "kind": "COLOR",
      "displayOrder": 70,
      "defaultValue": ""
    },
    {
      "propertyKey": "radius",
      "label": "Corner radius (px)",
      "kind": "NUMBER",
      "displayOrder": 90,
      "defaultValue": 20
    },
    {
      "propertyKey": "shadow",
      "label": "Shadow",
      "kind": "SELECT",
      "displayOrder": 120,
      "defaultValue": "medium",
      "choices": [
        {
          "key": "none",
          "label": "None"
        },
        {
          "key": "small",
          "label": "Small"
        },
        {
          "key": "medium",
          "label": "Medium"
        },
        {
          "key": "large",
          "label": "Large"
        }
      ]
    },
    {
      "propertyKey": "objectApiName",
      "label": "Source Object",
      "kind": "OBJECT",
      "displayOrder": 300,
      "defaultValue": ""
    }
  ],
  "eventDefinitions": [
    {
      "apiName": "change",
      "label": "change"
    }
  ]
}
