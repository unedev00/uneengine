# Production requires a trusted certificate in ./certs.
SSL_TYPE=manual
SSL_CERT_PATH=/tmp/dms/custom-certs/fullchain.pem
SSL_KEY_PATH=/tmp/dms/custom-certs/privkey.pem
ENABLE_CLAMAV=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_RSPAMD=0
ENABLE_FAIL2BAN=0
ENABLE_POP3=0
ENABLE_IMAP=1
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
LOG_LEVEL=info
TZ=Europe/London
